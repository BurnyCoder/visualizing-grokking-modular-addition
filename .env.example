# .env.example — every configurable setting of the grokviz pipeline, with safe defaults.
# Global context: copy this file to `.env` (gitignored) and edit values there; src/grokviz/config.py
# loads `.env` with python-dotenv (https://pypi.org/project/python-dotenv/) and falls back to these
# defaults, so the pipeline also runs with no .env at all. Never put real tokens in .env.example.

# ---------------------------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------------------------
# Force UTF-8 for Python I/O on Windows (default console code page cp1252 cannot print math symbols).
# Source: https://docs.python.org/3/using/cmdline.html#envvar-PYTHONUTF8
PYTHONUTF8=1
# Required by torch.use_deterministic_algorithms(True) for deterministic cuBLAS matmuls on CUDA >= 10.2.
# Source: https://pytorch.org/docs/stable/notes/randomness.html
CUBLAS_WORKSPACE_CONFIG=:4096:8
# "auto" picks CUDA when available, else CPU; or set "cuda" / "cpu" explicitly.
GROKVIZ_DEVICE=auto

# ---------------------------------------------------------------------------------------------
# Output directories (all gitignored; relative to the repo root)
# ---------------------------------------------------------------------------------------------
GROKVIZ_RUNS_DIR=runs
GROKVIZ_DATA_DIR=data
GROKVIZ_SITE_DIR=site
GROKVIZ_LOGS_DIR=logs
GROKVIZ_REPORTS_DIR=reports

# ---------------------------------------------------------------------------------------------
# Task and model (paper mainline, Nanda et al. 2023 Sec. 3 and App. A; https://arxiv.org/abs/2301.05217)
# ---------------------------------------------------------------------------------------------
GROKVIZ_P=113
GROKVIZ_FRAC_TRAIN=0.3
GROKVIZ_D_MODEL=128
GROKVIZ_D_MLP=512
GROKVIZ_N_HEADS=4
GROKVIZ_D_HEAD=32
GROKVIZ_N_CTX=3

# ---------------------------------------------------------------------------------------------
# Optimisation (paper Sec. 3 + its released code progress-measures-paper/transformers.py)
# ---------------------------------------------------------------------------------------------
GROKVIZ_LR=0.001
GROKVIZ_WEIGHT_DECAY=1.0
GROKVIZ_BETA1=0.9
GROKVIZ_BETA2=0.98
GROKVIZ_WARMUP_STEPS=10
GROKVIZ_NUM_STEPS=40000
GROKVIZ_CKPT_EVERY=100
GROKVIZ_OPTIM_EVERY=1000
GROKVIZ_NORMS_EVERY=10
# Test loss/accuracy logging interval (the paper's mainline run logged test loss every 10 steps).
GROKVIZ_TEST_EVERY=10

# ---------------------------------------------------------------------------------------------
# Run matrix (seed lists use "a-b" ranges or comma lists; see docs/preregistration.md)
# ---------------------------------------------------------------------------------------------
GROKVIZ_WD1_SEEDS=0-10
GROKVIZ_WD0_SEEDS=0-4
GROKVIZ_RAND_SEEDS=0-2
GROKVIZ_SPLIT0_INIT_SEEDS=100-102

# ---------------------------------------------------------------------------------------------
# Paper mainline checkpoints (downloaded, pinned, hash-checked)
# Source: https://huggingface.co/callummcdougall/grokking_full_run_data (revision + LFS sha256 via HF API)
# ---------------------------------------------------------------------------------------------
GROKVIZ_PAPER_HF_REPO=callummcdougall/grokking_full_run_data
GROKVIZ_PAPER_HF_FILE=full_run_data.pth
GROKVIZ_PAPER_HF_REVISION=80e5dbb5744dd3e958e45e56f7562a4d50c7400c
GROKVIZ_PAPER_SHA256=a151f02125a33d6647d7b27fce99ae145ff3b83abc0586a883acc73e8318d828
# arXiv PDFs used only locally to verify quotes on the website; never redistributed.
# Nanda et al. 2023 v3 (19 Oct 2023) and Power et al. 2022 v1 (6 Jan 2022).
GROKVIZ_PAPER_PDF_URL=https://arxiv.org/pdf/2301.05217v3
GROKVIZ_POWER_PDF_URL=https://arxiv.org/pdf/2201.02177v1

# ---------------------------------------------------------------------------------------------
# Hugging Face publishing (token: run `hf auth login` or set HF_TOKEN in your private .env)
# ---------------------------------------------------------------------------------------------
GROKVIZ_HF_RUNS_REPO=BurnyCoder/grokking-modular-addition-runs
GROKVIZ_HF_SITE_DATA_REPO=BurnyCoder/grokking-modular-addition-site-data
GROKVIZ_HF_COLLECTION_TITLE=Visualizing grokking modular addition
HF_TOKEN=
